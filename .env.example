# Public production URL (no trailing slash). Used for canonical URLs, sitemap, schema.
NEXT_PUBLIC_SITE_URL=https://www.ustenterprises.in

# Web3Forms access key used by contact & quote forms (public key by design).
NEXT_PUBLIC_WEB3FORMS_KEY=e8db4a00-9d48-4f28-9eb5-4d0dd07f62f4

# Search Console / Bing Webmaster verification tokens (optional - content value of the meta tag only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
